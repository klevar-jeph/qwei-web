# Cloudflare Pages redirects.
# Query strings are preserved automatically.

# /pay?... serves the payment-request fallback page (the App Links target
# registered in the Android manifest).
/pay /pay.html 200

# Old links generated by early app builds pointed at the Supabase edge
# function route — not used as an app registration on this domain, but
# harmless to keep working:
/functions/v1/pay /pay.html 200

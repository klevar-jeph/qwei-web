# Cloudflare Pages redirects. Query strings are always preserved.

# Android App Links verification fetches /.well-known/assetlinks.json —
# an exact path the app's manifest registration depends on. Folders starting
# with a dot don't survive drag-and-drop uploads on Windows, so the file is
# deployed at the root as app-links.json and 200-rewritten here.
# A 200 rewrite (not a redirect) responds directly on the fetched URL.
/.well-known/assetlinks.json /app-links.json 200

# Early app builds encoded links at the Supabase edge-function URL.
# They are still legitimate Qwei payment links — serve the same page.
/functions/v1/pay /pay/index.html 200
